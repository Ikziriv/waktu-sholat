package main

import "fmt"

// IndexPage — single hero screen (100dvh).
// Shows only the 3 essentials: time (clock), next prayer (sholat), qibla (kiblat).
// Everything else (full schedule, niat, location picker, method) opens in drawers.
templ IndexPage(data PageData) {
	if !data.HasLocation {
		@Onboarding(data.Cities)
	} else {
		// Top bar — title + location badge (click to open location drawer)
		<div class="hidden items-center justify-between md:flex">
			<h1 class="font-display text-sm font-extrabold tracking-[0.2em] text-fg uppercase">
				Waktu Sholat
			</h1>
			<button
				class="location-pill flex items-center gap-2 font-mono text-[11px] tracking-wider text-fg-muted transition-colors hover:text-fg"
				hx-get="/partials/location"
				hx-target="#drawer-body"
				hx-swap="innerHTML"
				hx-on::after-request="openDrawer()"
			>
				<span class="location-pill-dot" aria-hidden="true"></span>
				<span class="text-accent">
					if data.CityName != "" {
						{ data.CityName }
					} else {
						GPS
					}
				</span>
			</button>
		</div>

		// Center — clock (left) + qibla & quick-nav (center) + next prayer (right).
		// Mobile: stacked, centered. md+: 3-column grid so the compass stays
		// dead-center regardless of side-content width or whether NextPrayer
		// is present (the right column is always reserved).
		<div class="flex flex-1 flex-col items-center justify-center gap-6 md:gap-8">
			<div class="hero-row flex w-full flex-col items-center justify-center gap-6 md:grid md:grid-cols-3 md:items-center md:gap-4">
				<div class="hero-cell-left flex justify-center md:justify-self-start">
					@ClockSection()
				</div>
				<div class="hero-cell-center flex flex-col items-center gap-3 md:justify-self-center">
					@QiblaSection(data)
					// Quick-action menu — paired directly beneath the compass direction text.
					// Collapsed by default: a frosted + pill. Click expands Jadwal/Niat/Jamak/Ramadhan/Lokasi inline.
					<div class="hero-reveal hero-nav-wrap flex items-center justify-center gap-3" id="nav-wrap">
						<nav
							id="bottom-nav"
							class="hero-nav flex items-center gap-4 font-mono text-[10px] uppercase tracking-[0.2em]"
							aria-label="Menu navigasi"
						>
							<button
								class="text-fg-muted transition-colors hover:text-fg"
								hx-get="/partials/schedule"
								hx-target="#drawer-body"
								hx-swap="innerHTML"
								hx-on::after-request="openDrawer(); closeNav()"
							>
								Jadwal
							</button>
							<button
								class="text-fg-muted transition-colors hover:text-fg"
								hx-get="/partials/niat-list"
								hx-target="#drawer-body"
								hx-swap="innerHTML"
								hx-on::after-request="openDrawer(); closeNav()"
							>
								Niat
							</button>
							<button
								class="text-fg-muted transition-colors hover:text-fg"
								hx-get="/partials/jamak-list"
								hx-target="#drawer-body"
								hx-swap="innerHTML"
								hx-on::after-request="openDrawer(); closeNav()"
							>
								Jamak
							</button>
							<button
								class="text-fg-muted transition-colors hover:text-fg"
								hx-get="/partials/ramadan"
								hx-target="#drawer-body"
								hx-swap="innerHTML"
								hx-on::after-request="openDrawer(); closeNav()"
							>
								Ramadhan
							</button>
							<button
								class="text-fg-muted transition-colors hover:text-fg"
								hx-get="/partials/location"
								hx-target="#drawer-body"
								hx-swap="innerHTML"
								hx-on::after-request="openDrawer(); closeNav()"
							>
								Lokasi
							</button>
						</nav>
						<button
							class="hero-nav-trigger grid h-7 w-7 place-items-center rounded-full border border-border text-fg-muted transition-colors hover:text-fg hover:border-accent"
							type="button"
							onclick="toggleNav()"
							aria-label="Buka menu"
							aria-expanded="false"
							aria-controls="bottom-nav"
						>
							+
						</button>
					</div>
				</div>
				<div class="hero-cell-right flex justify-center md:justify-self-end md:text-right">
					if data.NextPrayer != nil {
						@NextPrayerSection(data.NextPrayer, data.NextIn)
					}
				</div>
			</div>
		</div>

		// Bottom dock — 5-column prayer schedule bar anchored cleanly at the bottom
		// so the 3D celestial sphere and astrolabe rings remain unobstructed.
		if data.NextPrayer != nil {
			<div class="mt-auto flex w-full justify-center pt-2">
				@PrayerPicker(data.Schedule, data.NextPrayer)
			</div>
		}
	}
}

// Onboarding — first-run two-step welcome shown when no location cookie
// is set. Step 1: Surah Al-Asr with translation (mission-control welcome
// card in a viewfinder frame). Step 2: the location picker (city list +
// GPS). The container carries data-step="1"; onboardingStep(n) toggles it
// and CSS handles the fade/slide between steps — no server round-trip.
templ Onboarding(cities []City) {
	<section class="onboarding hero-reveal mx-auto flex w-full max-w-md flex-1 flex-col items-center overflow-y-auto" data-step="1">
		@OnboardingWelcome()
		@OnboardingLocation(cities)
	</section>
}

// OnboardingWelcome — step 1: Surah Al-Asr + "Mulai" button.
// Glass card over the 3D moon (compass eclipse shadow suppressed),
// viewfinder corners as the signature frame, premium pill CTA.
templ OnboardingWelcome() {
	<div class="onboarding-step onboarding-step-1 viewfinder-full w-full p-8 md:p-10" data-step="1">
		<span class="vf-corner vf-tl"></span>
		<span class="vf-corner vf-tr"></span>
		<span class="vf-corner vf-bl"></span>
		<span class="vf-corner vf-br"></span>

		<div class="mb-1.5 text-center font-mono text-[10px] tracking-[0.3em] uppercase text-accent">
			Bismillah
		</div>
		<h2 class="mb-1 text-center font-display text-xl font-bold tracking-tight text-fg">
			Waktu Sholat
		</h2>
		<p class="mb-6 text-center font-mono text-[11px] tracking-wider text-fg-muted">
			Surah { fmt.Sprintf("%d", SurahAlAsr.Number) } // { SurahAlAsr.Name } // 3 Ayat
		</p>

		<p
			dir="rtl"
			lang="ar"
			class="onboarding-arabic mb-6 text-right font-arabic text-xl leading-loose text-fg md:text-2xl"
		>
			{ SurahAlAsr.Arabic }
		</p>

		// Transliteration — collapsible disclosure, collapsed by default so
		// the Mulai CTA gets proper breathing room. grid-template-rows
		// 0fr→1fr animates height smoothly without JS measurement (60fps,
		// GPU-cheap). Toggle is a thin mission-control strip with a +/− icon.
		<div class="surah-disclosure mb-4" data-disclosure>
			<button
				type="button"
				class="surah-disclosure-toggle"
				aria-expanded="false"
				aria-controls="surah-translit"
			>
				<span>Transliterasi</span>
				<span class="surah-disclosure-icon" aria-hidden="true">+</span>
			</button>
			<div class="surah-disclosure-content" id="surah-translit">
				<p class="surah-disclosure-inner font-mono text-xs italic leading-relaxed text-fg-muted">
					{ SurahAlAsr.Transliteration }
				</p>
			</div>
		</div>

		<p class="mb-8 font-mono text-xs leading-relaxed text-fg">
			{ SurahAlAsr.Translation }
		</p>

		<button
			type="button"
			class="onboarding-start"
			onclick="onboardingStep(2)"
		>
			<span>Mulai</span>
			<span class="onboarding-start-arrow" aria-hidden="true">→</span>
		</button>
	</div>
}

// OnboardingLocation — step 2: city picker + GPS, same mission-control
// console as the original LocationPicker. A back link returns to step 1.
templ OnboardingLocation(cities []City) {
	<div class="onboarding-step onboarding-step-2 viewfinder-full w-full p-8 md:p-10" data-step="2">
		<span class="vf-corner vf-tl"></span>
		<span class="vf-corner vf-tr"></span>
		<span class="vf-corner vf-bl"></span>
		<span class="vf-corner vf-br"></span>

		<div class="mb-1.5 text-center font-mono text-[10px] tracking-[0.3em] uppercase text-accent">
			SISTEM // LOKASI
		</div>
		<h2 class="mb-2 text-center font-display text-xl font-bold tracking-tight text-fg">
			Pilih Lokasi
		</h2>
		<p class="mb-6 text-center font-mono text-[11px] tracking-wider text-fg-muted">
			Pilih kota atau gunakan GPS
		</p>

		<form hx-post="/location" hx-swap="none" id="city-form">
			<input type="hidden" name="city" id="city-value"/>
			<div class="city-list" role="listbox" aria-label="Pilih kota">
				for _, c := range cities {
					<button
						type="button"
						class="city-row"
						role="option"
						aria-pressed="false"
						data-value={ c.Name + "|" + fmtFloat(c.Lat, 6) + "|" + fmtFloat(c.Lng, 6) }
						data-lat={ fmtFloat(c.Lat, 6) }
						data-lng={ fmtFloat(c.Lng, 6) }
						onclick="selectCity(this)"
					>
						<span class="city-row-name">{ c.Name }</span>
						<span class="city-row-marker" aria-hidden="true"></span>
					</button>
				}
			</div>

			<div class="coord-readout" aria-live="polite">
				<span class="coord-label">LAT</span>
				<span class="coord-value" id="coord-lat">--.------</span>
				<span class="coord-label">LNG</span>
				<span class="coord-value" id="coord-lng">--.------</span>
			</div>

			<button
				type="submit"
				class="city-confirm"
				id="city-confirm"
				disabled
			>
				Gunakan Kota
			</button>
		</form>

		<div class="my-6 flex items-center gap-3">
			<span class="h-px flex-1 bg-border"></span>
			<span class="text-[10px] tracking-[0.2em] uppercase text-fg-dim">atau</span>
			<span class="h-px flex-1 bg-border"></span>
		</div>

		<form hx-post="/location" hx-swap="none" onsubmit="return useGPS(this)" class="flex flex-col gap-4">
			<input type="hidden" name="lat"/>
			<input type="hidden" name="lng"/>
			<input type="hidden" name="method" value="mwl"/>
			<button
				type="submit"
				class="rounded-none border border-accent bg-transparent px-5 py-2.5 font-mono text-xs font-medium tracking-[0.15em] uppercase text-accent transition-colors hover:bg-accent-soft"
			>
				Gunakan GPS
			</button>
		</form>

		<button
			type="button"
			class="mt-6 w-full font-mono text-[10px] tracking-[0.2em] uppercase text-fg-dim transition-colors hover:text-fg-muted"
			onclick="onboardingStep(1)"
		>
			← Kembali
		</button>

		<noscript class="mt-4 text-center text-xs text-fg-dim">Aktifkan JavaScript untuk GPS.</noscript>
	</div>
}

// ClockSection — precision mission-control chronometer instrument.
// Driven client-side with zero network jitter, including 60s sweep bar,
// timezone readout, prayer-phase telemetry, and Gregorian + Hijriyah dates.
templ ClockSection() {
	<section class="hero-reveal flex flex-col items-center md:items-start">
		<div class="chronometer" id="chronometer-root">
			<div class="chrono-header">
				<span class="chrono-live-dot" aria-hidden="true"></span>
				<span class="chrono-eyebrow" id="chrono-phase-label">WAKTU LOKAL</span>
				<span class="chrono-tz" id="chrono-tz">LOC</span>
			</div>

			<time class="chrono-time-row terminal-glow" id="chrono-time">
				<span class="chrono-hm" id="chrono-hm">--:--</span>
				<span class="chrono-sec-wrap">
					<span class="chrono-colon" id="chrono-colon">:</span>
					<span class="chrono-ss" id="chrono-ss">--</span>
				</span>
			</time>

			<div class="chrono-progress-track" aria-hidden="true">
				<span class="chrono-progress-fill" id="chrono-sec-bar"></span>
			</div>

			<div class="chrono-dates">
				<span class="chrono-date-greg" id="chrono-date-greg">---</span>
				<span class="chrono-date-hijri" id="chrono-date-hijri">---</span>
			</div>
		</div>
	</section>
}

// NextPrayerSection — mission-control target prayer readout.
// Balances the left-hand chronometer with a structured telemetry card on the right.
templ NextPrayerSection(next *PrayerTime, in string) {
	<section class="hero-reveal next-prayer-panel flex flex-col items-center gap-1.5 text-center md:items-end md:text-right" id="next-prayer-display">
		<div class="next-prayer-header">
			<span class="next-prayer-dot" aria-hidden="true"></span>
			<span class="text-[10px] tracking-[0.28em] uppercase text-fg-dim" id="next-prayer-label">
				sholat berikutnya
			</span>
		</div>
		<div class="flex items-baseline gap-2.5">
			<span class="font-display text-2xl font-bold tracking-tight text-fg md:text-3xl" id="next-prayer-name">
				{ PrayerLabel[next.Name] }
			</span>
			<span class="next-prayer-time-badge font-mono text-xs tabular-nums text-accent" id="next-prayer-time">
				{ next.Time.Format("15:04") }
			</span>
		</div>
		<div class="next-prayer-progress-track" aria-hidden="true">
			<span class="next-prayer-progress-fill" id="next-prayer-bar"></span>
		</div>
		<span class="font-mono text-xs tabular-nums tracking-wider text-fg-muted" id="next-prayer-countdown">dalam { in }</span>
	</section>
}

// PrayerPicker — segmented control with a sliding accent underline.
// One row of 5 tappable segments (Subuh..Isya); each segment stacks the
// prayer name over its time, turning the control into an at-a-glance
// schedule. Tapping a segment eases a thin accent underline to it and
// updates NextPrayerSection via pickPrayer(). Each segment carries data-*
// attributes for the JS countdown logic. Replaces the native range slider
// — 48px touch targets, on-aesthetic with the thin-line viewfinder
// language, and the eased indicator motion (GPU transform only) is the
// premium feel. Document-level click handler in layout.templ dispatches
// .prayer-segment clicks to setPrayerPicker().
templ PrayerPicker(sched []PrayerTime, next *PrayerTime) {
	if len(sched) == 0 {
		return
	}
	{{ defaultIdx := pickerDefaultIndex(sched, next) }}
	<div
		class="prayer-segments hero-reveal flex w-full max-w-lg items-stretch font-mono"
		id="prayer-picker"
		role="group"
		aria-label="Pilih sholat"
		data-active={ fmt.Sprintf("%d", defaultIdx) }
		style={ "--count: " + fmt.Sprintf("%d", len(sched)) + "; --active: " + fmt.Sprintf("%d", defaultIdx) }
	>
		<span class="prayer-indicator" aria-hidden="true"></span>
		for i, p := range sched {
			<button
				class={ "prayer-segment hover:text-fg " + pickerStopClass(i, defaultIdx) }
				data-idx={ fmt.Sprintf("%d", i) }
				data-label={ PrayerLabel[p.Name] }
				data-time={ p.Time.Format("15:04") }
				data-iso={ p.Time.Format("2006-01-02T15:04:05Z07:00") }
				aria-pressed={ fmt.Sprintf("%t", i == defaultIdx) }
			>
				<span class="prayer-segment-name">{ PrayerLabel[p.Name] }</span>
				<span class="prayer-segment-time">{ p.Time.Format("15:04") }</span>
			</button>
		}
	</div>
}

// pickerDefaultIndex returns the schedule index of the next prayer,
// or the last index if all prayers have passed.
func pickerDefaultIndex(sched []PrayerTime, next *PrayerTime) int {
	if next != nil {
		for i, p := range sched {
			if p.Name == next.Name {
				return i
			}
		}
	}
	if len(sched) > 0 {
		return len(sched) - 1
	}
	return 0
}

// pickerStopClass highlights the active stop.
func pickerStopClass(i, defaultIdx int) string {
	if i == defaultIdx {
		return "text-accent"
	}
	return "text-fg-dim"
}

// LocationDrawer — location picker + method picker for the drawer.
templ LocationDrawer(data PageData) {
	<div class="p-6 md:p-8">
		<div class="flex items-center justify-between border-b border-border pb-4">
			<div>
				<span class="block text-[10px] tracking-[0.3em] uppercase text-fg-dim">Pengaturan</span>
				<h2 class="font-display text-xl font-bold tracking-tight text-fg">Lokasi & Metode</h2>
			</div>
			<button
				class="grid h-8 w-8 place-items-center rounded-full border border-border text-fg-muted transition-colors hover:text-fg hover:border-fg-muted"
				onclick="closeDrawer()"
				aria-label="Tutup"
			>
				✕
			</button>
		</div>

		// City picker
		<form hx-post="/location" hx-swap="none" class="mt-6 flex flex-col gap-4">
			<label class="flex flex-col gap-1.5 text-[10px] tracking-[0.2em] uppercase text-fg-muted">
				<span>Kota</span>
				<select
					name="city"
					class="appearance-none rounded-none border border-border bg-surface px-3 py-2.5 font-mono text-sm text-fg focus:outline-1 focus:outline-accent"
				>
					for _, c := range data.Cities {
						<option value={ c.Name + "|" + fmtFloat(c.Lat, 6) + "|" + fmtFloat(c.Lng, 6) }>{ c.Name }</option>
					}
				</select>
			</label>
			<button
				type="submit"
				class="rounded-none bg-fg px-5 py-2.5 font-mono text-xs font-medium tracking-[0.15em] uppercase text-bg transition-colors hover:bg-fg-muted"
			>
				Gunakan Kota
			</button>
		</form>

		<div class="my-6 flex items-center gap-3">
			<span class="h-px flex-1 bg-border"></span>
			<span class="text-[10px] tracking-[0.2em] uppercase text-fg-dim">atau</span>
			<span class="h-px flex-1 bg-border"></span>
		</div>

		// GPS
		<form hx-post="/location" hx-swap="none" onsubmit="return useGPS(this)" class="flex flex-col gap-4">
			<input type="hidden" name="lat"/>
			<input type="hidden" name="lng"/>
			<input type="hidden" name="method" value={ data.MethodID }/>
			<button
				type="submit"
				class="rounded-none border border-accent bg-transparent px-5 py-2.5 font-mono text-xs font-medium tracking-[0.15em] uppercase text-accent transition-colors hover:bg-accent-soft"
			>
				Gunakan GPS
			</button>
		</form>

		// Method picker
		@MethodPicker(data.MethodID)

		<button
			class="mt-6 w-full rounded-none border border-border bg-transparent px-5 py-2.5 font-mono text-xs font-medium tracking-[0.15em] uppercase text-fg-muted transition-colors hover:border-fg-muted hover:text-fg"
			onclick="closeDrawer()"
		>
			tutup
		</button>
	</div>
}

// NiatListDrawer — list of all 5 prayers, click to see niat.
templ NiatListDrawer() {
	<div class="p-6 md:p-8">
		<div class="flex items-center justify-between border-b border-border pb-4">
			<div>
				<span class="block text-[10px] tracking-[0.3em] uppercase text-fg-dim">Niat</span>
				<h2 class="font-display text-xl font-bold tracking-tight text-fg">Pilih Sholat</h2>
			</div>
			<button
				class="grid h-8 w-8 place-items-center rounded-full border border-border text-fg-muted transition-colors hover:text-fg hover:border-fg-muted"
				onclick="closeDrawer()"
				aria-label="Tutup"
			>
				✕
			</button>
		</div>

		<ul class="list-none">
			for _, name := range []PrayerName{ Subuh, Zuhur, Ashar, Maghrib, Isya } {
				<li class="border-b border-border-2">
					<button
						class="flex w-full items-center py-3 font-mono text-sm font-medium tracking-wide text-fg transition-colors hover:text-accent"
						hx-get={ "/partials/niat?prayer=" + string(name) }
						hx-target="#drawer-body"
						hx-swap="innerHTML"
					>
						{ PrayerLabel[name] }
						<span class="ml-auto text-fg-dim">→</span>
					</button>
				</li>
			}
		</ul>

		<button
			class="mt-6 w-full rounded-none border border-border bg-transparent px-5 py-2.5 font-mono text-xs font-medium tracking-[0.15em] uppercase text-fg-muted transition-colors hover:border-fg-muted hover:text-fg"
			onclick="closeDrawer()"
		>
			tutup
		</button>
	</div>
}

// JamakListDrawer — list of the four valid jamak combinations, click to see niat.
// Same shape as NiatListDrawer; rows are jamak pairs, not single prayers.
templ JamakListDrawer() {
	<div class="p-6 md:p-8">
		<div class="flex items-center justify-between border-b border-border pb-4">
			<div>
				<span class="block text-[10px] tracking-[0.3em] uppercase text-fg-dim">Jamak</span>
				<h2 class="font-display text-xl font-bold tracking-tight text-fg">Pilih Jamak</h2>
			</div>
			<button
				class="grid h-8 w-8 place-items-center rounded-full border border-border text-fg-muted transition-colors hover:text-fg hover:border-fg-muted"
				onclick="closeDrawer()"
				aria-label="Tutup"
			>
				✕
			</button>
		</div>

		<ul class="list-none">
			for _, j := range JamakList {
				<li class="border-b border-border-2">
					<button
						class="flex w-full items-center py-3 text-left font-mono text-sm font-medium tracking-wide text-fg transition-colors hover:text-accent"
						hx-get={ "/partials/jamak?first=" + string(j.First) + "&second=" + string(j.Second) + "&mode=" + string(j.Mode) }
						hx-target="#drawer-body"
						hx-swap="innerHTML"
					>
						<span class="flex flex-col gap-0.5">
							<span class="text-fg">{ PrayerLabel[j.First] } → { PrayerLabel[j.Second] }</span>
							<span class="text-[10px] tracking-[0.2em] uppercase text-fg-dim">
								if j.Mode == JamakTaqdim {
									Taqdim
								} else {
									Ta'khir
								}
							</span>
						</span>
						<span class="ml-auto text-fg-dim">→</span>
					</button>
				</li>
			}
		</ul>

		<button
			class="mt-6 w-full rounded-none border border-border bg-transparent px-5 py-2.5 font-mono text-xs font-medium tracking-[0.15em] uppercase text-fg-muted transition-colors hover:border-fg-muted hover:text-fg"
			onclick="closeDrawer()"
		>
			tutup
		</button>
	</div>
}
